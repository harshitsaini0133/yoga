datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============= User Schema =============
enum Role {
  SUPER_ADMIN
  SALES_ADMIN
  SUPPORT_ADMIN
  TRAINER
  DIETICIAN 
  USER
}
model User {
  id      Int    @id @default(autoincrement())
  name    String
  phNo    String? @unique
  email   String? @unique
  password String? 
  age     String? 
  role    Role   @default(USER) 

  // 🔥 OTP Security Fields
  otpSentAt   DateTime?
  otpExpiry   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt 
}

// ============= Subscription Schema =============
enum Duration {
  MONTHLY
  YEARLY
  QUARTERLY
}
enum Tab {
  BEST_VALUE
  MOST_POPULAR
  BEST_SAVINGS
}
model Subscription {
  id                Int      @id @default(autoincrement())
  name              String
  duration          Duration
  price             Decimal
  discount          Decimal
  sessions          Int?
  features          String[]
  tab               Tab?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model UserSubscription {
  id          Int      @id @default(autoincrement())
  userId      Int
  subscriptionId Int
  startDate   DateTime @default(now())
  endDate     DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============= Plan Schema =============
enum Status {
  SCHEDULED
  COMPLETED
  MISSED
  RESCHEDULED
}
model OnBoardingCall {
  id        Int      @id @default(autoincrement())
  userId    Int?
  userName  String
  userPhNo String
  date      DateTime
  status    Status

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

